# 서버
PORT=3000

# DB
DATABASE_URL=postgresql://user:password@localhost:5432/board

# JWT / 비밀번호 해시
JWT_SECRET=change-me
JWT_EXPIRES_IN=1h
BCRYPT_SALT_ROUNDS=10

# InfoTeam OAuth
INFOTEAM_CLIENT_ID=
INFOTEAM_CLIENT_SECRET=
INFOTEAM_AUTH_URL=
INFOTEAM_TOKEN_URL=
INFOTEAM_CALLBACK_URL=

# IDP userinfo
IDP_USERINFO_URL=
IDP_HTTP_TIMEOUT_MS=5000

# Push Server (docker-compose에서는 http://push-server:8090)
PUSH_SERVER_URL=http://localhost:8090

# Google OAuth (GoogleStrategy를 등록할 때만 필요)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=
