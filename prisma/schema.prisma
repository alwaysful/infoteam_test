generator client {
  provider = "prisma-client-js"
}

//DATABASE_URL="postgresql://postgres:1234@localhost:5432/infoteamtest"

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id String @id @default(uuid()) @db.Uuid

  username String? @unique
  name     String?
  email    String  @unique
  password String?

  sub      String? @unique
  provider String?

  createdAt DateTime @default(now())

  posts         Post[]
  subscriptions Subscription[]
}

model Post {
  id         Int      @id @default(autoincrement())
  title      String
  content    String

  userId     String   @db.Uuid
  categoryId Int

  user       User     @relation(fields: [userId], references: [id])
  category   Category @relation(fields: [categoryId], references: [id])

  createdAt DateTime @default(now())
}

model Category {
  id   Int    @id @default(autoincrement())
  name String @unique

  posts         Post[]
  subscriptions Subscription[]
}

model Subscription {
  userId     String @db.Uuid
  categoryId Int

  user     User     @relation(fields: [userId], references: [id])
  category Category @relation(fields: [categoryId], references: [id])

  @@id([userId, categoryId])
}

